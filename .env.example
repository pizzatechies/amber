# Copy to .env and adjust. Only DATABASE_URL is required to run locally.

# ── Database (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://amber:amber@localhost:5432/amber"

# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the site, used in emails and payment redirects.
APP_URL="http://localhost:3000"
# Brand name and currency are inlined at build time (rebuild after changing).
NEXT_PUBLIC_SITE_NAME="Amber"
# ISO 4217 code. Prices are stored in this currency's minor units.
NEXT_PUBLIC_CURRENCY="USD"

# ── File storage ─────────────────────────────────────────────────────
# "local" stores uploads on disk under UPLOAD_DIR (use a persistent volume in
# production). "s3" stores them in any S3-compatible bucket.
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Set for non-AWS providers (Cloudflare R2, MinIO, Backblaze, ...):
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="false"

# Upload limits in megabytes.
MAX_VIDEO_MB="2048"
MAX_FILE_MB="200"
MAX_IMAGE_MB="8"

# ── Payments ─────────────────────────────────────────────────────────
# "sandbox" simulates payments so the whole flow works without an account.
# It never charges anyone: switch to "stripe" before selling for real.
PAYMENT_PROVIDER="sandbox"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ── Email ────────────────────────────────────────────────────────────
# Without SMTP_URL, emails (password resets, receipts) are printed to the
# server log instead of being sent.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
MAIL_FROM="Amber <no-reply@example.com>"
