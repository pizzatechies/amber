# Copy to .env (in this folder) and fill in. Never commit the .env file.

# ── Address ──────────────────────────────────────────────────────────
# With a domain: SITE_ADDRESS=learn.example.com and APP_URL=https://learn.example.com
# Without one (testing only): SITE_ADDRESS=:80 and APP_URL=http://<server IP>
SITE_ADDRESS=:80
APP_URL=http://203.0.113.10

# ── Branding (applied when the image is built) ───────────────────────
SITE_NAME=Amber
CURRENCY=USD

# ── Database ─────────────────────────────────────────────────────────
# Password for the bundled PostgreSQL. Generate one with: openssl rand -hex 24
DB_PASSWORD=
# To use Amazon RDS instead, uncomment and fill in (see the guide):
# DATABASE_URL=postgresql://USER:PASSWORD@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/amber?sslmode=require

# ── First admin account (created on first start) ─────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── File storage ─────────────────────────────────────────────────────
# "local" keeps uploads on the server's disk (fine to start with).
# "s3" stores them in a bucket; give the server an IAM role with access to
# it and leave the key variables empty (see the guide).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1

# ── Payments ─────────────────────────────────────────────────────────
# "sandbox" never charges anyone. Switch to stripe before selling.
PAYMENT_PROVIDER=sandbox
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────────────────
# Without SMTP_URL, emails are only written to the app's log.
# Amazon SES works here: smtp://USER:PASS@email-smtp.us-east-1.amazonaws.com:587
# SMTP_URL=
MAIL_FROM=Amber <no-reply@example.com>
